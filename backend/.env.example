# Copy this file to `.env` in THIS folder (`backend/.env`) and fill in real values.
# NEVER commit `backend/.env` — it is gitignored.
# NEVER put real Gmail app passwords in `.env.example` — this file is public on GitHub.
#
# Local dev: Omit DATABASE_URL to use SQLite (db.sqlite3). A stale or sleepy cloud Postgres
# in DATABASE_URL often causes timeouts or intermittent "won't load" behavior on your machine.

DJANGO_SECRET_KEY=replace-with-strong-secret-key

# Omit DJANGO_EMAIL_BACKEND → console backend (dev notice on Contact page).
# For Gmail: uncomment SMTP lines below ONLY in your private `backend/.env`.

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DJANGO_DEFAULT_FROM_EMAIL=your-account@gmail.com
CONTACT_RECIPIENT_EMAIL=your-account@gmail.com

# Public site URL (order emails + track links)
SITE_URL=https://kistie-store-production.up.railway.app

# Staff inbox for order status alerts (includes WhatsApp click-to-chat links)
ORDER_ALERT_EMAIL=dallas8000@gmail.com
# Digits only (no +). Must match the number on Instagram / your business card.
# Examples: 256704757198  or  0704757198
WHATSAPP_STORE_NUMBER=256704757198

# Public business address shown on Contact / About pages.
STORE_ADDRESS=Prime Complex Building, Wilson Street, Shop No. C-03, Kampala, Uganda

# Optional: show Instagram strip on Shop + link on product pages
# INSTAGRAM_PROFILE_URL=https://www.instagram.com/kistie_storeug/

# --- AI features (required for shopping chat, sizing copy, staff describe, demand insights) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# FIT_RECOMMENDER_USE_AI=true

# Optional: Pesapal checkout redirects via Node payments service (defaults to local dev URL if unset).
# PESAPAL_INITIATE_URL=https://your-payments-service.up.railway.app/api/pay/pesapal

# Required for internal payment status callback authentication between Node payments service and Django.
# Use a long random value in production and set the same value in payments/.env.
INTERNAL_WEBHOOK_KEY=replace-with-long-random-shared-secret
